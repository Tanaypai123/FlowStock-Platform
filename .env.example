# FlowStock Environment Variables
# Monorepo Root Configuration Template (.env.example)

# ==============================================================================
# Supabase Configuration (Database & Authentication)
# ==============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Note: Express uses ANON key to validate Bearer JWTs; SERVICE_ROLE for admin API + DB.

# ==============================================================================
# Vite Client Environment Variables (Must start with VITE_)
# ==============================================================================
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ==============================================================================
# Server Configuration
# ==============================================================================
PORT=8000

# ==============================================================================
# External Services & Integrations (Optional / Feature-dependent)
# ==============================================================================
# Twilio WhatsApp Notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Route Optimization APIs (Tier 1: Google Maps, Tier 2: OpenRouteService)
GOOGLE_MAPS_API_KEY=
ORS_KEY=
